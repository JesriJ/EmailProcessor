# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=emailprocessor
POSTGRES_USER=email
# Local-dev default only — change before any shared or remote deploy
POSTGRES_PASSWORD=email

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=4
SPRING_PROFILES_ACTIVE=default
AI_SERVICE_URL=http://ai-service:8000
MAX_RETRIES=3
BASE_BACKOFF_MS=500
MAX_BACKOFF_MS=10000
MIN_IDLE_TIME_MS=60000
CLAIM_INTERVAL_MS=15000
CLAIM_BATCH_SIZE=10

# Mail mode: synthetic | gmail
MAIL_MODE=synthetic

# AI provider: ollama | openai | mock
LLM_PROVIDER=ollama
USE_MOCK_LLM=false

# Ollama (default local model)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Keep Ollama parallel slots modest on a single GPU (match WORKER_CONCURRENCY)
# OLLAMA_NUM_PARALLEL=2

# OpenAI (optional cloud path)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROMPT_VERSION=v1
CATEGORIES_FILE=/config/categories.lock

# Gmail product ingest
# 1) python scripts/gmail_oauth.py
# 2) set MAIL_MODE=gmail and USE_MOCK_GMAIL=false
# 3) powershell -File scripts/run_gmail_ingest.ps1
USE_MOCK_GMAIL=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SYNC_MAX_MESSAGES=50
GMAIL_SYNC_LOOKBACK_DAYS=7
# Optional extra Gmail search operators, e.g. in:inbox -category:promotions
GMAIL_QUERY=

# Pricing (USD per 1M tokens) for cost estimation
INPUT_PRICE_PER_1M=0.15
OUTPUT_PRICE_PER_1M=0.60
